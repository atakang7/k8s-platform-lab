#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly ROOT

fail() {
  printf 'FAIL | %s\n' "$1" >&2
  exit 1
}

read_secret_field() {
  local namespace="$1"
  local secret="$2"
  local field="$3"
  local encoded

  encoded="$(kubectl -n "${namespace}" get secret "${secret}" -o json 2>/dev/null |
    jq -er --arg field "${field}" '.data[$field]')" ||
    fail "secret/${secret} or field ${field} is unavailable in namespace ${namespace}"

  printf '%s' "${encoded}" | base64 --decode
}

print_credentials() {
  local jenkins_user
  local jenkins_password
  local grafana_user
  local grafana_password

  jenkins_user="$(read_secret_field jenkins jenkins-admin jenkins-admin-user)"
  jenkins_password="$(read_secret_field jenkins jenkins-admin jenkins-admin-password)"
  grafana_user="$(read_secret_field observability observability-grafana admin-user)"
  grafana_password="$(read_secret_field observability observability-grafana admin-password)"

  cat <<EOF
Jenkins
  URL:      https://jenkins.lab.test
  Username: ${jenkins_user}
  Password: ${jenkins_password}

Grafana
  URL:      https://observability.lab.test/grafana/
  Username: ${grafana_user}
  Password: ${grafana_password}
EOF
}

main() {
  case "${1:-}" in
    --cluster)
      [[ "$#" -eq 1 ]] || fail 'credentials cluster mode does not accept extra arguments'
      print_credentials
      ;;
    '')
      [[ "$#" -eq 0 ]] || fail 'credentials does not accept arguments'
      "${ROOT}/infra/edge/lib/with-kubeconfig.sh" bash "$0" --cluster
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
}

main "$@"
