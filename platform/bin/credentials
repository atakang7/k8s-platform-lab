#!/usr/bin/env bash
# Prints the Jenkins and Grafana logins, read from their Secrets in the cluster.
# Runs through the SSH tunnel to the cluster (with-kubeconfig.sh).
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly ROOT

fail() {
  printf 'FAIL | %s\n' "$1" >&2
  exit 1
}

print_credentials() {
  local jenkins_user
  local jenkins_password
  local grafana_user
  local grafana_password

  jenkins_user="$(kubectl -n jenkins get secret jenkins-admin \
    -o go-template='{{ index .data "jenkins-admin-user" | base64decode }}')" ||
    fail 'the Jenkins login is not available; run make jenkins-up first'
  jenkins_password="$(kubectl -n jenkins get secret jenkins-admin \
    -o go-template='{{ index .data "jenkins-admin-password" | base64decode }}')"
  grafana_user="$(kubectl -n observability get secret observability-grafana \
    -o go-template='{{ index .data "admin-user" | base64decode }}')" ||
    fail 'the Grafana login is not available; run make observability-up first'
  grafana_password="$(kubectl -n observability get secret observability-grafana \
    -o go-template='{{ index .data "admin-password" | base64decode }}')"

  cat <<EOF
Jenkins
  URL:      https://jenkins.lab.test
  Username: ${jenkins_user}
  Password: ${jenkins_password}

Grafana
  URL:      https://observability.lab.test/grafana/
  Username: ${grafana_user}
  Password: ${grafana_password}
EOF
}

main() {
  case "${1:-}" in
    '')
      [[ "$#" -eq 0 ]] || fail 'credentials does not accept arguments'
      exec "${ROOT}/infra/edge/lib/with-kubeconfig.sh" bash "$0" --cluster
      ;;
    --cluster)
      [[ "$#" -eq 1 ]] || fail 'credentials --cluster does not accept extra arguments'
      print_credentials
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
}

main "$@"
