#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
source "${root}/platform/jenkins/versions.env"
export VAULT_ADDR=https://127.0.0.1:8200

if [[ "${1:-}" != --cluster ]]; then
  if [[ -z "${VAULT_TOKEN:-}" ]]; then
    read -r -s -p 'Vault bootstrap token: ' VAULT_TOKEN
    echo
    export VAULT_TOKEN
  fi
  vault token lookup >/dev/null
  vault policy write jenkins-read "${root}/platform/jenkins/resources/admin-read.hcl" >/dev/null
  vault write auth/approle/role/jenkins-vso \
    token_policies=jenkins-read token_ttl=1h token_max_ttl=4h \
    secret_id_ttl=0 secret_id_num_uses=0 >/dev/null

  if ! vault kv get secret/jenkins/admin >/dev/null 2>&1; then
    temporary="$(mktemp -d)"
    chmod 0700 "${temporary}"
    trap 'rm -rf -- "${temporary}"' EXIT
    umask 077
    python3 - "${temporary}/admin.json" <<'PY'
import json
import secrets
import sys

with open(sys.argv[1], 'w') as destination:
    json.dump({'jenkins-admin-user': 'admin',
               'jenkins-admin-password': secrets.token_urlsafe(36)}, destination)
PY
    vault kv put secret/jenkins/admin "@${temporary}/admin.json" >/dev/null
  fi
  "${root}/infra/edge/lib/with-kubeconfig.sh" "${root}/platform/jenkins/bin/up" --cluster
  exit
fi

kubectl create namespace jenkins --dry-run=client -o yaml | kubectl apply -f - >/dev/null
temporary="$(mktemp -d)"
chmod 0700 "${temporary}"
trap 'rm -rf -- "${temporary}"' EXIT
kubectl -n jenkins create secret generic vault-ca \
  --from-file=ca.crt=/usr/local/share/ca-certificates/lab.crt \
  --dry-run=client -o yaml | kubectl apply -f - >/dev/null

if ! kubectl -n jenkins get secret approle-id >/dev/null 2>&1; then
  umask 077
  vault write -field=secret_id -f auth/approle/role/jenkins-vso/secret-id > "${temporary}/approle-id"
  kubectl -n jenkins create secret generic approle-id \
    --from-file="id=${temporary}/approle-id" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
fi

kubectl apply -f "${root}/platform/jenkins/resources/vault-connection.yaml" >/dev/null
role_id="$(vault read -field=role_id auth/approle/role/jenkins-vso/role-id)"
kubectl apply -f - >/dev/null <<EOF
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultAuth
metadata:
  name: jenkins
  namespace: jenkins
spec:
  vaultConnectionRef: edge
  method: appRole
  mount: approle
  appRole:
    roleId: ${role_id}
    secretRef: approle-id
EOF

kubectl apply -f "${root}/platform/jenkins/resources/admin-secret.yaml" >/dev/null
kubectl apply -f "${root}/platform/jenkins/resources/ci-secrets.yaml" >/dev/null
kubectl apply -f "${root}/platform/jenkins/resources/agent-rbac.yaml" >/dev/null
kubectl -n jenkins apply -f - >/dev/null <<'EOF'
apiVersion: v1
kind: Secret
metadata:
  name: jenkins-agent-token
  namespace: jenkins
  annotations:
    kubernetes.io/service-account.name: jenkins-agent
type: kubernetes.io/service-account-token
EOF
for _ in {1..30}; do
  if [[ -n "$(kubectl -n jenkins get secret jenkins-agent-token -o jsonpath='{.data.token}')" ]]; then break; fi
  sleep 2
done
kubectl -n jenkins get secret jenkins-agent-token -o json |
  python3 -c '
import base64, json, sys
secret = json.load(sys.stdin)
token = base64.b64decode(secret["data"]["token"]).decode()
ca = secret["data"]["ca.crt"]
kubeconfig = {
    "apiVersion": "v1", "kind": "Config",
    "clusters": [{"name": "cluster", "cluster": {
        "server": "https://kubernetes.default.svc.cluster.local", "certificate-authority-data": ca}}],
    "users": [{"name": "jenkins-agent", "user": {"token": token}}],
    "contexts": [{"name": "jenkins-agent", "context": {
        "cluster": "cluster", "user": "jenkins-agent", "namespace": "default"}}],
    "current-context": "jenkins-agent",
}
sys.stdout.write(base64.b64encode(json.dumps(kubeconfig).encode()).decode())
' | kubectl -n jenkins create secret generic jenkins-kubeconfig \
  --from-file=base64=/dev/stdin --dry-run=client -o yaml | kubectl apply -f - >/dev/null

for secret in jenkins-admin github-creds dockerhub-creds jenkins-kubeconfig; do
  for _ in {1..60}; do
    if kubectl -n jenkins get secret "${secret}" >/dev/null 2>&1; then break; fi
    sleep 2
  done
  kubectl -n jenkins get secret "${secret}" >/dev/null
done
[[ "$(kubectl auth can-i create deployments -n default --as=system:serviceaccount:jenkins:jenkins-agent)" == yes ]]
[[ "$(kubectl auth can-i create deployments -n kube-system --as=system:serviceaccount:jenkins:jenkins-agent)" == no ]]
for secret in jenkins-admin github-creds dockerhub-creds jenkins-kubeconfig; do
  [[ "$(kubectl -n jenkins get secret "${secret}" -o json | jq '.data | length')" -gt 0 ]]
done

helm repo add jenkins https://charts.jenkins.io --force-update >/dev/null
helm repo update jenkins >/dev/null
helm upgrade --install jenkins jenkins/jenkins \
  --namespace jenkins --version "${JENKINS_CHART_VERSION}" \
  --values "${root}/platform/jenkins/values.yaml" \
  --set-file controller.JCasC.configScripts.platform="${root}/platform/jenkins/jcasc/jenkins.yaml" \
  --wait --atomic --timeout 10m >/dev/null
echo 'PASS | Jenkins release reconciled'
