#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
readonly ROOT
readonly JENKINS_DIRECTORY="${ROOT}/platform/jenkins"
readonly JENKINS_NAMESPACE=jenkins

source "${JENKINS_DIRECTORY}/versions.env"
source "${ROOT}/infra/edge/lib/operator-state.sh"
source "${ROOT}/infra/edge/lib/vault-approle.sh"

fail() {
  printf 'FAIL | %s\n' "$1" >&2
  exit 1
}

phase() {
  printf 'WAIT | %s\n' "$1"
}

pass() {
  printf 'PASS | %s\n' "$1"
}

vault_fields_are_present() {
  local path="$1"
  shift

  local field
  local fields

  fields="$(vault kv get -format=json "${path}" 2>/dev/null |
    jq -c '.data.data' || true)"
  [[ -n "${fields}" ]] || return 1

  for field in "$@"; do
    jq -e --arg field "${field}" '
      has($field) and (.[$field] | strings | length > 0)
    ' <<< "${fields}" >/dev/null || return 1
  done
}

vault_fields_match() {
  local path="$1"
  local first_field="$2"
  local first_value="$3"
  local second_field="$4"
  local second_value="$5"

  vault kv get -format=json "${path}" 2>/dev/null |
    jq -e \
      --arg first_field "${first_field}" \
      --arg first_value "${first_value}" \
      --arg second_field "${second_field}" \
      --arg second_value "${second_value}" '
        .data.data[$first_field] == $first_value
        and .data.data[$second_field] == $second_value
      ' >/dev/null
}

# Stores a two-field external credential in Vault from operator variables.
# With both variables unset, an existing Vault entry is reused; returns 1 when
# neither exists.
#   reconcile_external_secret <path> <field> <value> <variable> <field> <value> <variable>
reconcile_external_secret() {
  local path="$1"
  local first_field="$2"
  local first_value="$3"
  local first_variable="$4"
  local second_field="$5"
  local second_value="$6"
  local second_variable="$7"

  if [[ -z "${first_value}" && -z "${second_value}" ]]; then
    if vault_fields_are_present "${path}" "${first_field}" "${second_field}"; then
      return 0
    fi
    return 1
  fi

  [[ -n "${first_value}" ]] ||
    fail "${first_variable} is required when ${second_variable} is set"
  [[ -n "${second_value}" ]] ||
    fail "${second_variable} is required when ${first_variable} is set"

  if vault_fields_match "${path}" \
    "${first_field}" "${first_value}" "${second_field}" "${second_value}"; then
    return 0
  fi

  jq -n \
    --arg first_field "${first_field}" \
    --arg first_value "${first_value}" \
    --arg second_field "${second_field}" \
    --arg second_value "${second_value}" \
    '{($first_field): $first_value, ($second_field): $second_value}' |
    vault kv put "${path}" - >/dev/null
}

reconcile_external_credentials() {
  local -a missing_paths=()

  reconcile_external_secret secret/ci/github \
    username "${GITHUB_USERNAME:-}" GITHUB_USERNAME \
    token "${GITHUB_TOKEN:-}" GITHUB_TOKEN ||
    missing_paths+=('secret/ci/github')

  reconcile_external_secret secret/ci/dockerhub \
    username "${DOCKERHUB_USERNAME:-}" DOCKERHUB_USERNAME \
    token "${DOCKERHUB_TOKEN:-}" DOCKERHUB_TOKEN ||
    missing_paths+=('secret/ci/dockerhub')

  reconcile_external_secret secret/ci/cosign \
    private_key "${COSIGN_PRIVATE_KEY:-}" COSIGN_PRIVATE_KEY \
    password "${COSIGN_PASSWORD:-}" COSIGN_PASSWORD ||
    missing_paths+=('secret/ci/cosign')

  if [[ "${#missing_paths[@]}" -eq 0 ]]; then
    return
  fi

  printf 'FAIL | missing external Jenkins credentials\n' >&2
  printf 'Missing Vault path: %s\n' "${missing_paths[@]}" >&2
  cat >&2 <<'MESSAGE'
Inject the variables for each missing path and rerun:
  export GITHUB_USERNAME='<GitHub username>'
  export GITHUB_TOKEN='<GitHub token with contents, commit-status and pull-request access>'
  export DOCKERHUB_USERNAME='<Docker Hub username>'
  export DOCKERHUB_TOKEN='<Docker Hub access token>'
  export COSIGN_PASSWORD='<new signing key password>'
  cosign generate-key-pair   # commit cosign.pub (see README.md), keep cosign.key out of Git
  export COSIGN_PRIVATE_KEY="$(cat cosign.key)"
  make jenkins-up
MESSAGE
  exit 1
}

ensure_admin_credential() (
  set -Eeuo pipefail

  local temporary_directory
  local generated_password

  if vault_fields_are_present \
    secret/jenkins/admin \
    jenkins-admin-user \
    jenkins-admin-password; then
    return
  fi

  temporary_directory="$(mktemp -d)"
  trap 'rm -rf -- "${temporary_directory}"' EXIT
  chmod 0700 "${temporary_directory}"
  umask 077

  generated_password="$(openssl rand -base64 36 | tr -d '\n')"

  jq -n \
    --arg password "${generated_password}" \
    '{
      "jenkins-admin-user": "admin",
      "jenkins-admin-password": $password
    }' > "${temporary_directory}/admin.json"

  vault kv put \
    secret/jenkins/admin \
    "@${temporary_directory}/admin.json" >/dev/null
)

configure_vault_identity() {
  vault policy write \
    jenkins-read \
    "${JENKINS_DIRECTORY}/resources/admin-read.hcl" >/dev/null

  vault write auth/approle/role/jenkins-vso \
    token_policies=jenkins-read \
    token_ttl=1h \
    token_max_ttl=4h \
    secret_id_ttl=0 \
    secret_id_num_uses=0 >/dev/null
}

operator_reconcile() {
  phase 'reconciling Jenkins credentials in Vault'

  require_vault_operator_token
  reconcile_external_credentials
  configure_vault_identity
  ensure_admin_credential

  pass 'Jenkins Vault credentials are current'
  phase 'reconciling Jenkins through the Kubernetes API tunnel'

  "${ROOT}/infra/edge/lib/with-kubeconfig.sh" "$0" --cluster
}

prepare_namespace() {
  kubectl create namespace "${JENKINS_NAMESPACE}" --dry-run=client -o yaml |
    kubectl apply -f - >/dev/null

  kubectl -n "${JENKINS_NAMESPACE}" create secret generic vault-ca \
    --from-file=ca.crt=/usr/local/share/ca-certificates/lab.crt \
    --dry-run=client -o yaml |
    kubectl apply -f - >/dev/null
}

reconcile_jenkins_approle() (
  set -Eeuo pipefail

  local temporary_directory
  local installed_role_id
  local role_id
  local identity_needs_rotation=false

  temporary_directory="$(mktemp -d)"
  trap 'rm -rf -- "${temporary_directory}"' EXIT
  chmod 0700 "${temporary_directory}"

  kubectl -n "${JENKINS_NAMESPACE}" get secret approle-id \
    -o jsonpath='{.data.id}' 2>/dev/null |
    base64 --decode > "${temporary_directory}/installed-secret-id" || true

  role_id="$(vault read -field=role_id auth/approle/role/jenkins-vso/role-id)"
  installed_role_id="$(kubectl -n "${JENKINS_NAMESPACE}" get vaultauth jenkins \
    -o jsonpath='{.spec.appRole.roleId}' 2>/dev/null || true)"

  if [[ "${installed_role_id}" != "${role_id}" ]]; then
    identity_needs_rotation=true
  fi

  if ! vault_approle_secret_is_valid \
    jenkins-vso "${temporary_directory}/installed-secret-id"; then
    identity_needs_rotation=true
  fi

  if [[ "${identity_needs_rotation}" == true ]]; then
    umask 077
    vault write -field=secret_id -f \
      auth/approle/role/jenkins-vso/secret-id \
      > "${temporary_directory}/secret-id"

    kubectl -n "${JENKINS_NAMESPACE}" create secret generic approle-id \
      --from-file="id=${temporary_directory}/secret-id" \
      --dry-run=client -o yaml |
      kubectl apply -f - >/dev/null
  fi

  kubectl apply \
    -f "${JENKINS_DIRECTORY}/resources/vault-connection.yaml" >/dev/null

  kubectl apply -f - >/dev/null <<EOF_VAULT_AUTH
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultAuth
metadata:
  name: jenkins
  namespace: ${JENKINS_NAMESPACE}
spec:
  vaultConnectionRef: edge
  method: appRole
  mount: approle
  appRole:
    roleId: ${role_id}
    secretRef: approle-id
EOF_VAULT_AUTH
)

apply_jenkins_resources() {
  kubectl apply \
    -f "${JENKINS_DIRECTORY}/resources/admin-secret.yaml" >/dev/null
  kubectl apply \
    -f "${JENKINS_DIRECTORY}/resources/ci-secrets.yaml" >/dev/null
  kubectl apply \
    -f "${JENKINS_DIRECTORY}/resources/agent-rbac.yaml" >/dev/null
}

remove_obsolete_delivery_access() {
  # Retain this cleanup because an operator may upgrade an older cluster
  # directly to the current repository state. These objects carried delivery
  # access before per-environment deploy identities (platform/environment).
  kubectl -n "${JENKINS_NAMESPACE}" delete secret \
    jenkins-agent-token \
    jenkins-kubeconfig \
    --ignore-not-found >/dev/null

  kubectl -n "${JENKINS_NAMESPACE}" delete serviceaccount \
    jenkins-agent \
    --ignore-not-found >/dev/null

  kubectl -n default delete role \
    jenkins-app-deployer \
    --ignore-not-found >/dev/null

  kubectl -n default delete rolebinding \
    jenkins-app-deployer \
    jenkins-ci-dry-run \
    --ignore-not-found >/dev/null
}

# True when every field of the Kubernetes Secret equals its Vault value.
secret_matches_vault() {
  local path="$1"
  local destination="$2"
  shift 2
  local field

  for field in "$@"; do
    [[ "$(vault kv get -format=json "${path}" |
        jq -j --arg field "${field}" '.data.data[$field]' | sha256sum)" == \
      "$(kubectl -n "${JENKINS_NAMESPACE}" get secret "${destination}" -o json |
        jq -r --arg field "${field}" '.data[$field]' | base64 --decode | sha256sum)" ]] ||
      return 1
  done
}

# Vault Secrets Operator syncs a changed Vault value within its refresh
# interval (1m), so a Secret is given two minutes to catch up before failing.
wait_for_vault_secret() {
  local resource="$1"
  local path="$2"
  local destination="$3"
  shift 3

  kubectl -n "${JENKINS_NAMESPACE}" wait \
    --for=condition=Ready \
    "vaultstaticsecret/${resource}" \
    --timeout=2m >/dev/null

  for _ in {1..24}; do
    secret_matches_vault "${path}" "${destination}" "$@" && return
    sleep 5
  done
  fail "secret/${destination} does not match ${path}"
}

verify_vault_secrets() {
  phase 'waiting for Vault-managed Jenkins Secrets'

  wait_for_vault_secret \
    jenkins-admin \
    secret/jenkins/admin \
    jenkins-admin \
    jenkins-admin-user \
    jenkins-admin-password

  wait_for_vault_secret \
    github-creds \
    secret/ci/github \
    github-creds \
    username \
    token

  wait_for_vault_secret \
    dockerhub-creds \
    secret/ci/dockerhub \
    dockerhub-creds \
    username \
    token

  wait_for_vault_secret \
    cosign-signing \
    secret/ci/cosign \
    cosign-signing \
    private_key \
    password

  pass 'Vault-managed Jenkins Secrets match Vault'
}

verify_agent_cluster_scope() {
  [[ "$(kubectl auth can-i create deployments \
    --all-namespaces \
    --as="system:serviceaccount:${JENKINS_NAMESPACE}:jenkins-ci")" == no ]] ||
    fail 'jenkins-ci has cluster-wide deployment rights'
}

install_jenkins() {
  phase 'reconciling the Jenkins Helm release'

  helm repo add jenkins https://charts.jenkins.io --force-update >/dev/null
  helm repo update jenkins >/dev/null

  helm upgrade --install jenkins jenkins/jenkins \
    --namespace "${JENKINS_NAMESPACE}" \
    --version "${JENKINS_CHART_VERSION}" \
    --values "${JENKINS_DIRECTORY}/values.yaml" \
    --set-file \
      controller.JCasC.configScripts.platform="${JENKINS_DIRECTORY}/jcasc/jenkins.yaml" \
    --wait \
    --rollback-on-failure \
    --timeout 10m \
    --history-max 5 \
    --hide-notes

  pass 'Jenkins release reconciled'
}

cluster_reconcile() {
  prepare_namespace
  reconcile_jenkins_approle
  apply_jenkins_resources
  remove_obsolete_delivery_access
  verify_vault_secrets
  verify_agent_cluster_scope
  install_jenkins
}

main() {
  case "${1:-}" in
    --cluster)
      [[ "$#" -eq 1 ]] || fail 'Jenkins cluster mode does not accept extra arguments'
      cluster_reconcile
      ;;
    '')
      [[ "$#" -eq 0 ]] || fail 'Jenkins reconciliation does not accept arguments'
      operator_reconcile
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
}

main "$@"
