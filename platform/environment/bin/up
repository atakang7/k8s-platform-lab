#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
readonly ROOT
readonly ENVIRONMENT_CONFIG="${ROOT}/environments.yaml"
readonly ENVIRONMENT_MANIFEST="${ROOT}/platform/environment/namespace.yaml"
readonly REGISTRY_POLICY="${ROOT}/platform/environment/registry-pull-read.hcl"

source "${ROOT}/infra/edge/lib/operator-state.sh"
source "${ROOT}/infra/edge/lib/vault-approle.sh"

fail() {
  printf 'FAIL | %s\n' "$1" >&2
  exit 1
}

phase() {
  printf 'WAIT | %s\n' "$1"
}

# Every delivery environment in promotion order, one "name namespace" line each.
read_environments() {
  python3 - "${ENVIRONMENT_CONFIG}" <<'PY'
import sys
import yaml

config_path = sys.argv[1]
with open(config_path, encoding="utf-8") as source:
    config = yaml.safe_load(source)

environments = config.get("environments") if isinstance(config, dict) else None
if not isinstance(environments, list) or not environments:
    raise SystemExit(f"{config_path}: environments must be a non-empty list")

for environment in environments:
    name = environment.get("name") if isinstance(environment, dict) else None
    namespace = environment.get("namespace") if isinstance(environment, dict) else None
    if not isinstance(name, str) or not isinstance(namespace, str):
        raise SystemExit(f"{config_path}: every environment needs a name and a namespace")
    print(name, namespace)
PY
}

validate_environment_identity() {
  local environment_name="$1"
  local namespace="$2"
  local -r dns_label_pattern='^[a-z0-9]([-a-z0-9]*[a-z0-9])?$'

  [[ "${environment_name}" =~ ${dns_label_pattern} && "${#environment_name}" -le 63 ]] ||
    fail "environment name must be a DNS label of at most 63 characters: ${environment_name}"
  [[ "${namespace}" =~ ${dns_label_pattern} && "${#namespace}" -le 63 ]] ||
    fail "namespace must be a DNS label of at most 63 characters: ${namespace}"
}

reconcile_registry_vault_access() {
  phase 'reconciling runtime registry access in Vault'

  require_vault_operator_token

  vault kv get secret/runtime/dockerhub >/dev/null 2>&1 ||
    fail 'secret/runtime/dockerhub is missing; store the runtime registry credential in Vault first'

  vault policy write registry-pull-read "${REGISTRY_POLICY}" >/dev/null
  vault write auth/approle/role/registry-pull-vso \
    token_policies=registry-pull-read \
    token_ttl=1h \
    token_max_ttl=4h \
    secret_id_ttl=0 \
    secret_id_num_uses=0 >/dev/null
}

reconcile_registry_identity() (
  set -Eeuo pipefail

  local namespace="$1"
  local temporary_directory
  local installed_secret_id

  temporary_directory="$(mktemp -d)"
  trap 'rm -rf -- "${temporary_directory}"' EXIT
  chmod 0700 "${temporary_directory}"

  installed_secret_id="${temporary_directory}/installed-secret-id"
  kubectl -n "${namespace}" get secret registry-pull-approle \
    -o jsonpath='{.data.id}' 2>/dev/null |
    base64 --decode > "${installed_secret_id}" || true

  if vault_approle_secret_is_valid registry-pull-vso "${installed_secret_id}"; then
    return
  fi

  umask 077
  vault write -field=secret_id -f \
    auth/approle/role/registry-pull-vso/secret-id \
    > "${temporary_directory}/new-secret-id"

  kubectl -n "${namespace}" create secret generic registry-pull-approle \
    --from-file="id=${temporary_directory}/new-secret-id" \
    --dry-run=client -o yaml |
    kubectl apply -f - >/dev/null
)

apply_environment_manifest() {
  local environment_name="$1"
  local namespace="$2"
  local role_id="$3"

  [[ -n "${role_id}" ]] || fail 'registry-pull-vso role ID is empty'

  # namespace.yaml deliberately uses three plain placeholders. Keep the render
  # visible here instead of hiding a one-file template behind another tool.
  sed \
    -e "s/__NAMESPACE__/${namespace}/g" \
    -e "s/__ENVIRONMENT__/${environment_name}/g" \
    -e "s/__ROLE_ID__/${role_id}/g" \
    "${ENVIRONMENT_MANIFEST}" |
    kubectl apply -f - >/dev/null

  kubectl -n "${namespace}" create secret generic vault-ca \
    --from-file=ca.crt=/usr/local/share/ca-certificates/lab.crt \
    --dry-run=client -o yaml |
    kubectl apply -f - >/dev/null
}

# Each environment's deploy identity releases into its own namespace only.
verify_cd_access() {
  local environment_name="$1"
  local namespace="$2"
  local -r cd_identity="system:serviceaccount:jenkins:jenkins-deploy-${environment_name}"

  [[ "$(kubectl auth can-i create deployments \
    --namespace "${namespace}" \
    --as="${cd_identity}")" == yes ]] ||
    fail "jenkins-deploy-${environment_name} cannot deploy to ${namespace}"

  [[ "$(kubectl auth can-i create deployments \
    --all-namespaces \
    --as="${cd_identity}")" == no ]] ||
    fail "jenkins-deploy-${environment_name} can deploy outside ${namespace}"

  [[ "$(kubectl auth can-i get secrets \
    --namespace "${namespace}" \
    --as="${cd_identity}")" == no ]] ||
    fail "jenkins-deploy-${environment_name} can read Secrets"
}

# Clusters set up before per-environment deploy identities still carry the
# token-minting model; remove it so no identity keeps that access.
remove_token_minting_access() {
  local namespace="$1"

  kubectl -n "${namespace}" delete \
    serviceaccount/deployer \
    role/deployer-token-minter \
    rolebinding/deployer-token-minter \
    --ignore-not-found >/dev/null
}

verify_ci_dry_run_only() {
  local namespace="$1"
  local denial
  local -r ci_identity=system:serviceaccount:jenkins:jenkins-ci

  if denial="$(kubectl -n "${namespace}" create configmap delivery-probe \
    --from-literal=probe=1 \
    --as="${ci_identity}" 2>&1)"; then
    kubectl -n "${namespace}" delete configmap delivery-probe >/dev/null
    fail 'jenkins-ci can write to the cluster'
  fi

  [[ "${denial}" == *jenkins-ci-dry-run-only* ]] ||
    fail "unexpected CI denial: ${denial}"
}

verify_access_model() {
  local environment_name="$1"
  local namespace="$2"

  verify_cd_access "${environment_name}" "${namespace}"
  verify_ci_dry_run_only "${namespace}"
}

verify_registry_secret() {
  local namespace="$1"

  kubectl -n "${namespace}" wait \
    --for=condition=Ready vaultstaticsecret/registry-pull \
    --timeout=2m >/dev/null

  kubectl -n "${namespace}" get secret registry-pull >/dev/null ||
    fail 'registry-pull Secret is missing'
}

cluster_reconcile() {
  local environments
  local environment_name
  local namespace
  local role_id

  environments="$(read_environments)"
  role_id="$(vault read -field=role_id auth/approle/role/registry-pull-vso/role-id)"

  while read -r environment_name namespace; do
    validate_environment_identity "${environment_name}" "${namespace}"

    phase "reconciling environment ${environment_name} in namespace ${namespace}"
    apply_environment_manifest "${environment_name}" "${namespace}" "${role_id}"
    reconcile_registry_identity "${namespace}"
    remove_token_minting_access "${namespace}"
    verify_access_model "${environment_name}" "${namespace}"
    verify_registry_secret "${namespace}"

    printf 'PASS | environment %s (%s)\n' "${environment_name}" "${namespace}"
  done <<<"${environments}"
}

operator_reconcile() {
  reconcile_registry_vault_access
  phase 'reconciling application environments through the Kubernetes API tunnel'
  "${ROOT}/infra/edge/lib/with-kubeconfig.sh" "$0" --cluster
}

main() {
  case "${1:-}" in
    --cluster)
      [[ "$#" -eq 1 ]] || fail 'environment cluster mode does not accept extra arguments'
      cluster_reconcile
      ;;
    '')
      [[ "$#" -eq 0 ]] || fail 'environment reconciliation does not accept arguments'
      operator_reconcile
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
}

main "$@"
