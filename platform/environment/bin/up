#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
readonly root
source "${root}/infra/edge/lib/operator-state.sh"
source "${root}/infra/edge/lib/vault-approle.sh"

fail() {
  printf 'FAIL | %s\n' "$1" >&2
  exit 1
}

read_environment() {
  python3 - "${root}/environment.yaml" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as source:
    environment = yaml.safe_load(source)

print(environment["name"], environment["namespace"])
PY
}

validate_environment_name() {
  local name="$1" namespace="$2"
  [[ "${name}" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
    fail "environment name is not a DNS label: ${name}"
  [[ "${namespace}" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
    fail "namespace is not a DNS label: ${namespace}"
}

configure_vault() {
  require_vault_operator_token
  vault kv get secret/runtime/dockerhub >/dev/null 2>&1 ||
    fail 'secret/runtime/dockerhub is missing; store the runtime registry credential in Vault first'

  vault policy write registry-pull-read "${root}/platform/environment/registry-pull-read.hcl" >/dev/null
  vault write auth/approle/role/registry-pull-vso \
    token_policies=registry-pull-read \
    token_ttl=1h \
    token_max_ttl=4h \
    secret_id_ttl=0 \
    secret_id_num_uses=0 >/dev/null
}

reconcile_registry_identity() (
  set -Eeuo pipefail

  local namespace="$1"
  local temporary installed_secret

  temporary="$(mktemp -d)"
  trap 'rm -rf -- "${temporary}"' EXIT
  chmod 0700 "${temporary}"
  installed_secret="${temporary}/installed-secret-id"

  kubectl -n "${namespace}" get secret registry-pull-approle \
    -o jsonpath='{.data.id}' 2>/dev/null |
    base64 --decode > "${installed_secret}" || true

  if ! vault_approle_secret_is_valid registry-pull-vso "${installed_secret}"; then
    umask 077
    vault write -field=secret_id -f auth/approle/role/registry-pull-vso/secret-id \
      > "${temporary}/new-secret-id"
    kubectl -n "${namespace}" create secret generic registry-pull-approle \
      --from-file="id=${temporary}/new-secret-id" \
      --dry-run=client -o yaml |
      kubectl apply -f - >/dev/null
  fi
)

apply_environment() {
  local environment="$1" namespace="$2" role_id="$3"

  sed \
    -e "s/__NAMESPACE__/${namespace}/g" \
    -e "s/__ENVIRONMENT__/${environment}/g" \
    -e "s/__ROLE_ID__/${role_id}/g" \
    "${root}/platform/environment/namespace.yaml" |
    kubectl apply -f - >/dev/null

  kubectl -n "${namespace}" create secret generic vault-ca \
    --from-file=ca.crt=/usr/local/share/ca-certificates/lab.crt \
    --dry-run=client -o yaml |
    kubectl apply -f - >/dev/null
}

verify_access_model() {
  local namespace="$1" output
  local -r cd_agent=system:serviceaccount:jenkins:jenkins-agent
  local -r ci_agent=system:serviceaccount:jenkins:jenkins-ci

  [[ "$(kubectl auth can-i create serviceaccounts/deployer \
    --subresource=token -n "${namespace}" --as="${cd_agent}")" == yes ]] ||
    fail 'CD cannot mint deployer tokens'

  [[ "$(kubectl auth can-i create deployments \
    -n "${namespace}" --as="${cd_agent}")" == no ]] ||
    fail 'CD holds deploy rights directly'

  if output="$(kubectl -n "${namespace}" create configmap delivery-probe \
    --from-literal=probe=1 --as="${ci_agent}" 2>&1)"; then
    kubectl -n "${namespace}" delete configmap delivery-probe >/dev/null
    fail 'jenkins-ci can write to the cluster'
  fi

  [[ "${output}" == *jenkins-ci-dry-run-only* ]] ||
    fail "unexpected CI denial: ${output}"
}

verify_registry_secret() {
  local namespace="$1"

  kubectl -n "${namespace}" wait \
    --for=condition=Ready vaultstaticsecret/registry-pull \
    --timeout=2m >/dev/null

  kubectl -n "${namespace}" get secret registry-pull >/dev/null ||
    fail 'registry-pull Secret is missing'
}

cluster_reconcile() {
  local environment namespace role_id

  read -r environment namespace < <(read_environment)
  validate_environment_name "${environment}" "${namespace}"

  role_id="$(vault read -field=role_id auth/approle/role/registry-pull-vso/role-id)"
  apply_environment "${environment}" "${namespace}" "${role_id}"
  reconcile_registry_identity "${namespace}"
  verify_access_model "${namespace}"
  verify_registry_secret "${namespace}"

  printf 'PASS | environment %s (%s)\n' "${environment}" "${namespace}"
}

main() {
  if [[ "${1:-}" == --cluster ]]; then
    cluster_reconcile
    return
  fi

  configure_vault
  "${root}/infra/edge/lib/with-kubeconfig.sh" "$0" --cluster
}

main "$@"
