# Operator credentials for this lab.
# Copy to .env and fill in the values. Never commit .env (.gitignore has it).
#
# Inject them into Vault (run from the repository root, after `make edge-up`):
#
#   set -a; source .env; set +a
#   export VAULT_ADDR=https://127.0.0.1:8200
#   export VAULT_TOKEN="$(jq -r .root_token ~/.local/share/lab-operator/vault-init.json)"
#
#   vault kv put secret/ci/github        username="$GITHUB_USERNAME"    token="$GITHUB_TOKEN"
#   vault kv put secret/ci/dockerhub     username="$DOCKERHUB_USERNAME" token="$DOCKERHUB_TOKEN"
#   vault kv put secret/ci/cosign        private_key="$COSIGN_PRIVATE_KEY" password="$COSIGN_PASSWORD"
#   vault kv put secret/runtime/dockerhub username="$RUNTIME_DOCKERHUB_USERNAME" token="$RUNTIME_DOCKERHUB_TOKEN"
#
# Then continue with `make jenkins-up` and `make environment-up`.

# secret/ci/github: Jenkins reads the repository and reports commit status.
GITHUB_USERNAME='<GitHub username>'
GITHUB_TOKEN='<GitHub token: contents, commit statuses, pull requests>'

# secret/ci/dockerhub: Jenkins pushes images.
DOCKERHUB_USERNAME='<Docker Hub username>'
DOCKERHUB_TOKEN='<Docker Hub access token>'

# secret/ci/cosign: Jenkins signs images. Matches the committed cosign.pub.
COSIGN_PASSWORD='<password of the cosign key>'
COSIGN_PRIVATE_KEY='<contents of cosign.key; must match the committed cosign.pub>'

# secret/runtime/dockerhub: the cluster pulls application images.
RUNTIME_DOCKERHUB_USERNAME='<Docker Hub username the cluster pulls with>'
RUNTIME_DOCKERHUB_TOKEN='<Docker Hub read token>'
