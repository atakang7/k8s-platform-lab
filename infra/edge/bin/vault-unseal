#!/usr/bin/env bash
set -Eeuo pipefail
export VAULT_ADDR=https://127.0.0.1:8200
status_code=0
status_json="$(vault status -format=json 2>/dev/null)" || status_code=$?
[[ "${status_code}" == 0 || "${status_code}" == 2 ]] || { echo 'FAIL | cannot read Vault state' >&2; exit 1; }
if python3 -c 'import json,sys; sys.exit(not json.load(sys.stdin)["sealed"])' <<< "${status_json}"; then
  echo 'Vault is sealed; enter an operator-held unseal key at the hidden prompt.'
  vault operator unseal
else
  echo 'PASS | Vault is already unsealed'
fi
