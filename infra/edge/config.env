# Shared edge values.
EDGE_NETWORK_CIDR=192.168.56.0/24
EDGE_HOST_IP=192.168.56.1
NODE2_EDGE_IP=192.168.56.11
NODE3_EDGE_IP=192.168.56.12
# Vault Secrets Operator reaches Vault from the worker edge IPs. AppRole logins
# for in-cluster roles are only accepted from these addresses.
CLUSTER_VAULT_CLIENTS=192.168.56.11/32,192.168.56.12/32
METALLB_POOL_START=192.168.56.200
METALLB_POOL_END=192.168.56.220
INGRESS_VIP=192.168.56.200
DNS_ZONE=lab.test

# Local-lab root of trust. This stays outside the repository and is mode 0600.
OPERATOR_STATE_DIRECTORY="${OPERATOR_STATE_DIRECTORY:-$(getent passwd "$(id -un)" | cut -d: -f6)/.local/share/lab-operator}"
VAULT_INIT_OUTPUT="${VAULT_INIT_OUTPUT:-${OPERATOR_STATE_DIRECTORY}/vault-init.json}"
