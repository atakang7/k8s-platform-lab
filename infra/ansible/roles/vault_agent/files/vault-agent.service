[Unit]
Description=Lab Vault Agent for BIND
After=vault.service
Requires=vault.service

[Service]
User=bind
Group=bind
RuntimeDirectory=vault-agent lab-bind
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/vault agent -config=/etc/vault-agent/agent.hcl
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
