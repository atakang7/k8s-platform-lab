apiVersion: v1
kind: Namespace
metadata:
  name: stage1-validation
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: network-check
  namespace: stage1-validation
spec:
  replicas: 2
  selector:
    matchLabels:
      app: network-check
  template:
    metadata:
      labels:
        app: network-check
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app: network-check
              topologyKey: kubernetes.io/hostname
      containers:
        - name: server
          image: "{{ validation_busybox_image }}"
          command: ["sh", "-c"]
          args:
            - mkdir -p /tmp/www; echo healthy > /tmp/www/health; httpd -f -p 8080 -h /tmp/www
          ports:
            - containerPort: 8080
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 1
            periodSeconds: 2
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 65534
            capabilities:
              drop: ["ALL"]
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: storage-check
  namespace: stage1-validation
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: local-path
  resources:
    requests:
      storage: 16Mi
---
apiVersion: v1
kind: Pod
metadata:
  name: storage-check
  namespace: stage1-validation
spec:
  containers:
    - name: writer
      image: "{{ validation_busybox_image }}"
      command: ["sh", "-c", "echo storage-ready > /data/result; sleep 3600"]
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 100m
          memory: 64Mi
      volumeMounts:
        - name: data
          mountPath: /data
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: storage-check

