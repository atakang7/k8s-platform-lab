#!/usr/bin/env bash
# Installs the tools this repository needs on an Ubuntu x86_64 host.
# Safe to run more than once.
# Vault and BIND9 are not installed here. `make edge-up` installs them.
set -euo pipefail


echo "==> Checking that the CPU supports virtualization"

if ! grep -qE 'vmx|svm' /proc/cpuinfo; then
  echo "CPU virtualization is off, so VirtualBox cannot run VMs."
  echo "Enable VT-x/AMD-V in the BIOS, or nested virtualization if this host is a VM."
  exit 1
fi


echo "==> Adding apt repositories"

sudo apt-get update
sudo apt-get install -y ca-certificates curl gnupg lsb-release
sudo mkdir -p /etc/apt/keyrings

# Vagrant
curl -fsSL https://apt.releases.hashicorp.com/gpg \
  | sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/hashicorp.gpg
echo "deb [signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" \
  | sudo tee /etc/apt/sources.list.d/hashicorp.list

# kubectl. Keep v1.34 equal to kubernetes_version in infra/ansible/group_vars/all.yml.
curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.34/deb/Release.key \
  | sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/kubernetes.gpg
echo "deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/v1.34/deb/ /" \
  | sudo tee /etc/apt/sources.list.d/kubernetes.list

# Helm
curl -fsSL https://packages.buildkite.com/helm-linux/helm-debian/gpgkey \
  | sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/helm.gpg
echo "deb [signed-by=/etc/apt/keyrings/helm.gpg] https://packages.buildkite.com/helm-linux/helm-debian/any/ any main" \
  | sudo tee /etc/apt/sources.list.d/helm.list


echo "==> Installing packages"

sudo apt-get update

# VirtualBox builds its kernel modules against the running kernel's headers.
sudo apt-get install -y virtualbox "linux-headers-$(uname -r)"
sudo apt-get install -y vagrant

# The full ansible package, not ansible-core: the roles need its
# ansible.posix and community.general collections.
sudo apt-get install -y ansible

sudo apt-get install -y kubectl helm
sudo apt-get install -y docker.io

# bind9-dnsutils provides dig and nsupdate.
sudo apt-get install -y bind9-dnsutils jq python3-yaml git make openssh-client iproute2


echo "==> Turning off VirtualBox's default DHCP server on vboxnet0"

# It hands out 192.168.56.101-254, which overlaps the MetalLB pool.
# The Vagrantfile refuses to start until it is off.
if VBoxManage list dhcpservers | grep -q 'HostInterfaceNetworking-vboxnet0'; then
  VBoxManage dhcpserver modify --netname HostInterfaceNetworking-vboxnet0 --disable
fi


echo "==> Adding $USER to the vboxusers and docker groups"

sudo usermod -aG vboxusers,docker "$USER"


echo
echo "Done. Log out and back in so the new groups apply."
