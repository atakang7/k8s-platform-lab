def timed(String label, Closure body) {
    def started = System.currentTimeMillis()
    echo "TIMING_START|${label}|${started}"
    try {
        body()
    } finally {
        def elapsed = System.currentTimeMillis() - started
        echo "TIMING|${label}|${elapsed}"
    }
}

pipeline {
    agent { label 'lab-cd-runner' }
    parameters {
        string(name: 'IMAGE_REF', description: 'Immutable image reference repository@sha256:...')
        string(name: 'COMMIT_SHA', description: 'Exact Git commit SHA associated with this deployment')
    }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }
    stages {
        stage('Prepare') {
            steps {
                script {
                    timed('Deploy.ValidateInput') {
                        // IMAGE_REF is validated by the Ansible role, which pins the repository.
                        if (!(params.COMMIT_SHA ==~ /^[0-9a-f]{40}$/)) {
                            error('COMMIT_SHA must be a full Git SHA')
                        }
                    }

                    timed('Deploy.Checkout') {
                        checkout scm
                        sh "git checkout --detach ${params.COMMIT_SHA}"
                    }

                    timed('Deploy.GitHubPending') {
                        container('ci-tools') {
                            withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                                sh "sh delivery/ci/github-status.sh pending jenkins/deploy 'Jenkins deploy running' '${params.COMMIT_SHA}'"
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    timed('Deploy.Ansible') {
                        container('ci-tools') {
                            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                                sh '''
                                  set -eu
                                  export K8S_AUTH_KUBECONFIG="$KUBECONFIG"
                                  ansible-playbook delivery/ansible/deploy.yml -e "image_ref=${IMAGE_REF}"
                                '''
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        success {
            script {
                timed('Deploy.GitHubSuccess') {
                    container('ci-tools') {
                        withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                            sh "sh delivery/ci/github-status.sh success jenkins/deploy 'Jenkins deploy passed' '${params.COMMIT_SHA}'"
                        }
                    }
                }
            }
        }
        failure {
            script {
                container('ci-tools') {
                    withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                        sh "sh delivery/ci/github-status.sh failure jenkins/deploy 'Jenkins deploy failed' '${params.COMMIT_SHA}' || true"
                    }
                }
            }
        }
    }
}
