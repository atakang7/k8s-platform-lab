def timed(String label, Closure body) {
    def started = System.currentTimeMillis()
    echo "TIMING_START|${label}|${started}"
    try {
        body()
    } finally {
        def elapsed = System.currentTimeMillis() - started
        echo "TIMING|${label}|${elapsed}"
    }
}

pipeline {
    agent {
        kubernetes {
            yamlFile 'delivery/jenkins/agent.yaml'
        }
    }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }
    environment {
        IMAGE_REPOSITORY = 'docker.io/atakangul/sample-java-app'
        CI_COMPLETE = 'false'
    }
    stages {
        stage('Test') {
            steps {
                script {
                    timed('Test.Checkout') {
                        def scmVars = checkout scm
                        env.COMMIT_SHA = scmVars.GIT_COMMIT
                    }

                    timed('Test.GitHubPending') {
                        container('ci-tools') {
                            withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                                sh 'sh delivery/ci/github-status.sh pending jenkins/ci "Jenkins CI running" "$COMMIT_SHA"'
                            }
                        }
                    }

                    def checks = [:]

                    checks['Unit Tests'] = {
                        timed('Test.UnitTests') {
                            container('ci-tools') {
                                sh 'delivery/ci/test.sh'
                            }
                        }
                    }

                    checks['Dockerfile Lint'] = {
                        timed('Test.DockerfileLint') {
                            container('ci-tools') {
                                sh 'hadolint app/Dockerfile'
                            }
                        }
                    }

                    checks['Kubernetes Dry Run'] = {
                        timed('Test.KubernetesDryRun') {
                            container('ci-tools') {
                                sh '''
                                  kubectl apply --dry-run=server -f app/k8s/fluent-bit-config.yaml
                                  kubectl apply --dry-run=server -f app/k8s/service.yaml
                                  kubectl apply --dry-run=server -f app/k8s/ingress.yaml
                                  kubectl apply --dry-run=server -f app/k8s/deployment.yaml
                                '''
                            }
                        }
                    }

                    checks['Ansible Syntax'] = {
                        timed('Test.AnsibleSyntax') {
                            container('ci-tools') {
                                sh 'ansible-playbook --syntax-check delivery/ansible/deploy.yml'
                            }
                        }
                    }

                    def checksStarted = System.currentTimeMillis()
                    parallel checks
                    echo "TIMING|Test.ChecksWall|${System.currentTimeMillis() - checksStarted}"
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    timed('Build.BuildAndPush') {
                        container('buildkit') {
                            withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                                sh '''
                                  set +x
                                  export DOCKER_CONFIG="$(mktemp -d)"
                                  trap 'rm -rf "$DOCKER_CONFIG"' EXIT
                                  AUTH="$(printf '%s:%s' "$DOCKER_USER" "$DOCKER_PASS" | base64 | tr -d '\\n')"
                                  printf '{"auths":{"docker.io":{"auth":"%s"},"https://index.docker.io/v1/":{"auth":"%s"}}}' "$AUTH" "$AUTH" > "$DOCKER_CONFIG/config.json"
                                  chmod 600 "$DOCKER_CONFIG/config.json"
                                  delivery/ci/build-image.sh
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Scan & Publish') {
            steps {
                script {
                    timed('Publish.TrivyAndSBOM') {
                        container('ci-tools') {
                            withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                                sh 'delivery/ci/scan-image.sh'
                            }
                        }
                    }

                    timed('Publish.GitHubSuccess') {
                        container('ci-tools') {
                            withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                                sh 'sh delivery/ci/github-status.sh success jenkins/ci "Jenkins CI passed" "$COMMIT_SHA"'
                            }
                        }
                    }

                    env.CI_COMPLETE = 'true'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'sbom.json', allowEmptyArchive: true
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    timed('Deploy.DownstreamJob') {
                        def imageRef = readFile('image_ref.env').trim().split('=', 2)[1]
                        build job: 'lab-deploy', parameters: [
                            string(name: 'IMAGE_REF', value: imageRef),
                            string(name: 'COMMIT_SHA', value: env.COMMIT_SHA)
                        ], wait: true, propagate: true
                    }
                }
            }
        }
    }
    post {
        failure {
            script {
                if (env.COMMIT_SHA && env.CI_COMPLETE != 'true') {
                    container('ci-tools') {
                        withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                            sh 'sh delivery/ci/github-status.sh failure jenkins/ci "Jenkins CI failed" "$COMMIT_SHA" || true'
                        }
                    }
                }
            }
        }
    }
}
