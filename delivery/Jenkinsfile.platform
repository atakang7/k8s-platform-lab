// Repository-level validation and base-chart publication. Platform and infra
// are reconciled by the operator (`make`), never applied by Jenkins.
@Library('lab-delivery') _

pipeline {
    agent { label 'lab-ci-runner' }
    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 20, unit: 'MINUTES')
    }
    stages {
        stage('Shell') {
            steps {
                container('ci-tools') {
                    sh '''
                      find delivery infra platform policies validation -type f \
                        \( -name '*.sh' -o -path '*/bin/*' \) \
                        -exec shellcheck --external-sources --source-path=SCRIPTDIR {} +
                    '''
                }
            }
        }

        stage('Chart lint') {
            when {
                allOf {
                    changeRequest()
                    anyOf {
                        changeset 'charts/**'
                        // A new multibranch job has no changelog yet. Validate the
                        // repository once instead of silently skipping chart checks.
                        expression { currentBuild.previousBuild == null }
                    }
                }
            }
            steps {
                container('chart-testing') {
                    sh '''
                      git config --global --add safe.directory "$PWD"
                      ct lint \
                        --target-branch "$CHANGE_TARGET" \
                        --chart-dirs charts \
                        --check-version-increment
                    '''
                }
            }
        }

        stage('Chart publish') {
            when {
                allOf {
                    branch 'main'
                    anyOf {
                        changeset 'charts/**'
                        // First main build must publish the current base charts so a
                        // fresh Jenkins controller can bootstrap an empty registry.
                        expression { currentBuild.previousBuild == null }
                    }
                }
            }
            steps {
                script {
                    env.CHART_REF = delivery.environment().chartRegistry
                    delivery.installScripts()
                }
                container('ci-tools') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            usernameVariable: 'REGISTRY_USERNAME',
                            passwordVariable: 'REGISTRY_PASSWORD'
                        )
                    ]) {
                        sh '''
                          for chart_file in charts/*/Chart.yaml; do
                            [ -f "$chart_file" ] || continue
                            CHART_DIR="${chart_file%/Chart.yaml}" .delivery/publish-chart.sh
                          done
                        '''
                    }
                }
            }
        }

        stage('Policy artifacts') {
            when {
                anyOf {
                    changeset 'policies/**'
                    expression { currentBuild.previousBuild == null }
                }
            }
            steps {
                container('ci-tools') {
                    sh '''
                      helm lint policies/resource-requests-webhook/helm/resource-requests-webhook
                      hadolint policies/resource-requests-webhook/Dockerfile
                    '''
                }
            }
        }
    }
}
