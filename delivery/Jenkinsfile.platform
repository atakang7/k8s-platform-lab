// This repository's platform layers, as a GitHub multibranch job. Pull
// requests lint; main also publishes base charts. Platform and infra are
// applied by the operator (`make`), never by Jenkins.
@Library('lab-delivery') _

pipeline {
    agent { label 'lab-ci-runner' }
    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 20, unit: 'MINUTES')
    }
    stages {
        stage('Shell') {
            steps {
                container('ci-tools') {
                    sh '''
                      find delivery infra platform policies validation -type f \\( -name '*.sh' -o -path '*/bin/*' \\) \\
                        -exec shellcheck --external-sources --source-path=SCRIPTDIR {} +
                    '''
                }
            }
        }
        stage('Chart lint') {
            when {
                allOf {
                    changeRequest()
                    changeset 'charts/**'
                }
            }
            steps {
                container('chart-testing') {
                    sh '''
                      git config --global --add safe.directory "$PWD"
                      ct lint --target-branch "$CHANGE_TARGET" --chart-dirs charts --check-version-increment
                    '''
                }
            }
        }
        stage('Chart publish') {
            when {
                allOf {
                    branch 'main'
                    changeset 'charts/**'
                }
            }
            steps {
                script {
                    env.CHART_REF = delivery.environment().chartRegistry
                    delivery.installScripts()
                }
                container('ci-tools') {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_PASSWORD')]) {
                        sh 'for chart in charts/*/; do CHART_DIR="$chart" .delivery/publish-chart.sh; done'
                    }
                }
            }
        }
        stage('Platform') {
            when {
                anyOf {
                    changeset 'platform/**'
                    changeset 'policies/**'
                }
            }
            steps {
                container('ci-tools') {
                    sh '''
                      helm lint policies/resource-requests-webhook/helm/resource-requests-webhook
                      hadolint policies/resource-requests-webhook/Dockerfile
                    '''
                }
            }
        }
    }
}
