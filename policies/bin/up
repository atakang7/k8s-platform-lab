#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly ROOT
readonly POLICY_NAMESPACE=policy-system
readonly RESOURCE_REQUESTS_WEBHOOK=resource-requests-webhook
readonly RESOURCE_REQUESTS_CHART="${ROOT}/policies/resource-requests-webhook/helm/resource-requests-webhook"

fail() {
  printf 'FAIL | %s\n' "$1" >&2
  exit 1
}

phase() {
  printf 'WAIT | %s\n' "$1"
}

pass() {
  printf 'PASS | %s\n' "$1"
}

# The image digest desired in ENVIRONMENT's state/<name>.yaml, recorded there
# by delivery. Admission policy is cluster-wide, so the operator chooses which
# environment's digest this cluster runs.
resolve_state_digest() {
  local name="$1"

  : "${ENVIRONMENT:?ENVIRONMENT is required, e.g. make policies-up ENVIRONMENT=prod}"

  python3 - "${ROOT}/state/${ENVIRONMENT}.yaml" "${name}" <<'PY'
import sys
import yaml

path, name = sys.argv[1:]
with open(path, encoding="utf-8") as source:
    state = yaml.safe_load(source)

services = state.get("services") if isinstance(state, dict) else None
if not isinstance(services, dict) or name not in services:
    raise SystemExit(f"{path}: services has no entry for {name}")

print((services[name] or {}).get("image") or "")
PY
}

reconcile_resource_requests_webhook() {
  local digest

  digest="$(resolve_state_digest "${RESOURCE_REQUESTS_WEBHOOK}")"
  [[ "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    fail "state/${ENVIRONMENT}.yaml has no ${RESOURCE_REQUESTS_WEBHOOK} digest yet; its CI on main records one in state/dev.yaml, then promote it"

  phase 'reconciling policy resource-requests-webhook (timeout: 5m)'

  helm upgrade --install "${RESOURCE_REQUESTS_WEBHOOK}" \
    "${RESOURCE_REQUESTS_CHART}" \
    --namespace "${POLICY_NAMESPACE}" \
    --create-namespace \
    --set-string "image.digest=${digest}" \
    --wait \
    --rollback-on-failure \
    --timeout 5m \
    --history-max 5 \
    --hide-notes

  pass 'policy resource-requests-webhook reconciled'
}

reconcile_policy() {
  local policy="$1"

  case "${policy}" in
    resource-requests-webhook)
      reconcile_resource_requests_webhook
      ;;
    *)
      fail "unknown policy '${policy}'; supported policies: resource-requests-webhook"
      ;;
  esac
}

cluster_reconcile() {
  local requested="$1"

  if [[ "${requested}" == all ]]; then
    requested=resource-requests-webhook
  fi

  reconcile_policy "${requested}"
}

operator_reconcile() {
  local requested="$1"

  "${ROOT}/infra/edge/lib/with-kubeconfig.sh" \
    "$0" --cluster "${requested}"
}

main() {
  case "${1:-}" in
    --cluster)
      [[ "$#" -eq 2 ]] || fail 'cluster mode requires exactly one policy name'
      cluster_reconcile "$2"
      ;;
    '')
      fail 'policy name is required; run make policy-up POLICY=resource-requests-webhook'
      ;;
    *)
      [[ "$#" -eq 1 ]] || fail 'policy reconciliation accepts exactly one policy name'
      operator_reconcile "$1"
      ;;
  esac
}

main "$@"
