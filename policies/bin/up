#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly ROOT
readonly POLICY_NAMESPACE=policy-system
readonly RESOURCE_REQUESTS_WEBHOOK=resource-requests-webhook
readonly RESOURCE_REQUESTS_CHART="${ROOT}/policies/resource-requests-webhook/helm/resource-requests-webhook"

fail() {
  printf 'FAIL | %s\n' "$1" >&2
  exit 1
}

phase() {
  printf 'WAIT | %s\n' "$1"
}

pass() {
  printf 'PASS | %s\n' "$1"
}

resolve_resource_requests_digest() {
  local configured_digest="${RESOURCE_REQUESTS_WEBHOOK_IMAGE_DIGEST:-}"
  local installed_image

  if [[ -n "${configured_digest}" ]]; then
    printf '%s\n' "${configured_digest}"
    return
  fi

  installed_image="$(kubectl -n "${POLICY_NAMESPACE}" get deployment "${RESOURCE_REQUESTS_WEBHOOK}" \
    -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || true)"

  if [[ "${installed_image}" == *@sha256:* ]]; then
    printf '%s\n' "${installed_image##*@}"
    return
  fi

  fail 'resource-requests-webhook needs RESOURCE_REQUESTS_WEBHOOK_IMAGE_DIGEST=sha256:<64 lowercase hex>; publish the image, export its digest, and rerun make policy-up POLICY=resource-requests-webhook'
}

reconcile_resource_requests_webhook() {
  local digest

  digest="$(resolve_resource_requests_digest)"
  [[ "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    fail 'RESOURCE_REQUESTS_WEBHOOK_IMAGE_DIGEST must be sha256:<64 lowercase hex characters>'

  phase 'reconciling policy resource-requests-webhook (timeout: 5m)'

  helm upgrade --install "${RESOURCE_REQUESTS_WEBHOOK}" \
    "${RESOURCE_REQUESTS_CHART}" \
    --namespace "${POLICY_NAMESPACE}" \
    --create-namespace \
    --set-string "image.digest=${digest}" \
    --wait \
    --rollback-on-failure \
    --timeout 5m \
    --history-max 5 \
    --hide-notes

  pass 'policy resource-requests-webhook reconciled'
}

reconcile_policy() {
  local policy="$1"

  case "${policy}" in
    resource-requests-webhook)
      reconcile_resource_requests_webhook
      ;;
    *)
      fail "unknown policy '${policy}'; supported policies: resource-requests-webhook"
      ;;
  esac
}

cluster_reconcile() {
  local requested="$1"

  if [[ "${requested}" == all ]]; then
    requested=resource-requests-webhook
  fi

  reconcile_policy "${requested}"
}

operator_reconcile() {
  local requested="$1"

  "${ROOT}/infra/edge/lib/with-kubeconfig.sh" \
    "$0" --cluster "${requested}"
}

main() {
  case "${1:-}" in
    --cluster)
      [[ "$#" -eq 2 ]] || fail 'cluster mode requires exactly one policy name'
      cluster_reconcile "$2"
      ;;
    '')
      fail 'policy name is required; run make policy-up POLICY=resource-requests-webhook'
      ;;
    *)
      [[ "$#" -eq 1 ]] || fail 'policy reconciliation accepts exactly one policy name'
      operator_reconcile "$1"
      ;;
  esac
}

main "$@"
